# Public — exposed to the browser. Must include /api/v1.
# Local:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# UAT (Vercel): https://<salon-api>.onrender.com/api/v1

# App shell
NEXT_PUBLIC_APP_NAME=Salon Management

# Optional: enable React Query devtools in development
NEXT_PUBLIC_ENABLE_QUERY_DEVTOOLS=true
