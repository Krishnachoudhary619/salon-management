APP_NAME=Salon Backend
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Hosted Postgres (Neon / Render / Supabase). When set, this wins over DB_*.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_SSL=true

DB_HOST=localhost
DB_PORT=5432
DB_NAME=salon
DB_USER=salon
DB_PASSWORD=salon
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE_SECONDS=1800
DB_CONNECT_ATTEMPTS=30
DB_CONNECT_RETRY_BASE_SECONDS=0.5
DB_CONNECT_TIMEOUT_SECONDS=5
DB_COMMAND_TIMEOUT_SECONDS=10

JWT_SECRET=local-dev-only-secret-key-not-for-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# Comma-separated origins. Must not be * in production.
CORS_ORIGINS=*
# Comma-separated Host values. Must not be * in production.
ALLOWED_HOSTS=*
TRUST_PROXY_HEADERS=false
ENABLE_HSTS=false

LOG_LEVEL=INFO
LOG_JSON=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60

WAIT_FOR_DATABASE=true
READY_CHECK_DATABASE=true
GRACEFUL_SHUTDOWN_SECONDS=30

SEED_ADMIN_NAME=Salon Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=AdminPass123!
SEED_STAFF_PASSWORD=StaffPass123!
